{
  "name": "cicd-taskapi",
  "version": "1.0.0",
  "description": "A small Task REST API used to demonstrate Docker + GitHub Actions CI/CD",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit",
    "test:api": "jest tests/api --runInBand"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": { "lines": 60, "statements": 60 }
    }
  }
}
